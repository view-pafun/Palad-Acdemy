rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Connection Health Check
    match /test/{testId} {
      allow read, write: if true;
    }

    // User Profiles & Student Data
    match /users/{userId} {
      allow read, write: if true;

      match /notes/{noteId} {
        allow read, write: if true;
      }
    }

    // Course Notes
    match /courseNotes/{noteId} {
      allow read, write: if true;
    }

    // Admin Directory
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Courses & Curriculum
    match /courses/{courseId} {
      allow read, write: if true;
    }

    // Knowledge Base & Blogs
    match /blogs/{blogId} {
      allow read, write: if true;
    }

    // Peer Stories (พี่ถึงน้อง)
    match /peerStories/{storyId} {
      allow read, write: if true;
    }

    // Events & Workshops
    match /events/{eventId} {
      allow read, write: if true;
    }

    // Site Settings (Hero Banner, announcements, etc.)
    match /siteSettings/{settingId} {
      allow read, write: if true;
    }
  }
}

